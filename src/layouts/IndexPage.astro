    <script>
      import { pressPostmark } from '../scripts/postmark.js';

      // ── terminal typing loop ──────────────────────────────────────────
      const SCRIPT = [
        { t: 'cmd',  text: '$ docker compose up -d\n', speed: 34 },
        { t: 'ok',   text: ' ✔ openagent-mailserver  Healthy\n ✔ openagent-api         Healthy\n\n', speed: 8 },
        { t: 'cmd',  text: '$ curl -X POST $API/v1/identities -d \'{"name":"signup-bot"}\'\n', speed: 26 },
        { t: 'json', text: ' {"address":"fox-k7d2@openagent.email","token":"oa_8f3k…"}\n\n', speed: 10 },
        { t: 'cmd',  text: '$ agent: mail_wait_for(subjectContains: "verify")\n', speed: 26 },
        { t: 'wait', text: ' ⏳ waiting for mail', speed: 30 },
        { t: 'wait', text: ' …', speed: 400 },
        { t: 'ok',   text: '\n 📩 new mail from noreply@github.com\n', speed: 12 },
        { t: 'json', text: ' {"otp":{"codes":["59162834"],"links":["https://github.com/…/confirm_verification/…"]}}\n\n', speed: 8 },
        { t: 'ok',   text: ' 📱 push sent to your phone\n', speed: 12 },
        { t: 'dim',  text: ' # code extracted. agent proceeds with signup. ✔\n', speed: 16 },
      ];
      const CLS = { cmd: 't-cmd', ok: 't-ok', json: 't-json', dim: 't-dim', wait: 't-wait' };

      function runTerminal() {
        const out = document.getElementById('term-out');
        if (!out) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          out.innerHTML = SCRIPT.map((l) => `<span class="${CLS[l.t]}">${esc(l.text)}</span>`).join('');
          return;
        }
        let line = 0;
        function typeLine() {
          if (line >= SCRIPT.length) {
            setTimeout(() => { out.innerHTML = ''; line = 0; typeLine(); }, 6000);
            return;
          }
          const { t, text, speed } = SCRIPT[line];
          const span = document.createElement('span');
          span.className = CLS[t];
          out.appendChild(span);
          let i = 0;
          (function tick() {
            span.textContent = text.slice(0, ++i);
            if (i < text.length) setTimeout(tick, speed);
            else { line++; setTimeout(typeLine, t === 'cmd' ? 350 : 120); }
          })();
        }
        typeLine();
      }
      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      // ── scroll reveal ─────────────────────────────────────────────────
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      document.querySelectorAll('.reveal').forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
      });

      // ── how-it-works: light the step rail as you scroll ───────────────
      const stepIO = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('lit', e.isIntersecting)),
        { rootMargin: '-35% 0px -35% 0px' },
      );
      document.querySelectorAll('#steps .step').forEach((el) => stepIO.observe(el));

      // ── spotlight + fine-pointer card tilt ────────────────────────────
      const cardFinePointer = window.matchMedia('(pointer: fine)').matches;
      const reduceCardMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.card:not(.card-cockpit)').forEach((card) => {
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;
        let pointerIsTouch = false;
        let resetTimer = 0;
        const tiltEnabled = cardFinePointer && !reduceCardMotion;

        card.addEventListener(
          'pointermove',
          (ev) => {
            pointerX = ev.clientX;
            pointerY = ev.clientY;
            pointerIsTouch = ev.pointerType === 'touch';
            if (frame) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              const r = card.getBoundingClientRect();
              if (!r.width || !r.height) return;
              const x = Math.max(0, Math.min(r.width, pointerX - r.left));
              const y = Math.max(0, Math.min(r.height, pointerY - r.top));
              card.style.setProperty('--mx', `${x}px`);
              card.style.setProperty('--my', `${y}px`);
              if (pointerIsTouch || !tiltEnabled) return;

              clearTimeout(resetTimer);
              const rx = (7 - (y / r.height) * 14).toFixed(2);
              const ry = (-7 + (x / r.width) * 14).toFixed(2);
              card.classList.remove('tilt-resetting');
              card.classList.add('tilt-active');
              card.style.transform =
                `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg) `
                + 'translateY(var(--card-lift))';
            });
          },
          { passive: true },
        );

        const resetTilt = () => {
          if (!tiltEnabled) return;
          if (frame) {
            cancelAnimationFrame(frame);
            frame = 0;
          }
          clearTimeout(resetTimer);
          card.classList.remove('tilt-active');
          card.classList.add('tilt-resetting');
          card.style.transform =
            'perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0px)';
          resetTimer = window.setTimeout(() => {
            card.classList.remove('tilt-resetting');
            card.style.removeProperty('transform');
          }, 300);
        };
        card.addEventListener('pointerleave', resetTilt);
        card.addEventListener('pointercancel', resetTilt);
      });

      // ── stat counters ─────────────────────────────────────────────────
      const countIO = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          countIO.unobserve(e.target);
          const target = Number(e.target.dataset.count);
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || target === 0) {
            e.target.textContent = String(target);
            return;
          }
          const t0 = performance.now();
          (function step(now) {
            const p = Math.min(1, (now - t0) / 1200);
            e.target.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(step);
          })(t0);
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));

      // ── copy buttons ──────────────────────────────────────────────────
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        const label = btn.querySelector('.copy-label') || btn;
        const copiedText = btn.dataset.copiedLabel || 'copied ✓';
        const resetText = btn.dataset.resetLabel || 'copy';
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy);
          } catch {
            return;
          }
          pressPostmark(btn, {
            stateClass: 'copied',
            onCopied: () => { label.textContent = copiedText; },
            onReset: () => { label.textContent = resetText; },
          });
        });
      });

      runTerminal();
    </script>

