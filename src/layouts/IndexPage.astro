---
import '../styles/global.css';
import StampWall from '../components/StampWall.astro';
import EnvelopeOrbit from '../components/EnvelopeOrbit.astro';
import FeatureViz from '../components/FeatureViz.astro';
import PaperPlane from '../components/PaperPlane.astro';
import JsonLd from '../components/JsonLd.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { MCP_TOOLS } from '../data/mcp-tools.js';
import { HTML_LANG, pageUrl } from '../i18n/config.js';
import { texts as en } from '../i18n/en.js';
import { texts as es } from '../i18n/es.js';
import { texts as ja } from '../i18n/ja.js';
import { texts as ko } from '../i18n/ko.js';
import { texts as zh } from '../i18n/zh.js';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const dicts = { en, es, ja, ko, zh };
const t = dicts[locale] || en;
const htmlLang = HTML_LANG[locale] || locale;
const pagePath = pageUrl(locale, 'index');
const currentUrl = `https://openagent.email${pagePath}`;

const rawMail = `From: noreply@github.com
To: fox-k7d2@yourdomain
Subject: [GitHub] Verify your email

Here's your GitHub launch code:

  <mark>59162834</mark>

Or <mark>verify your email address</mark> directly:
https://github.com/users/…/confirm_
verification/abc123?via_launch_…

This code expires in 10 minutes.`;

const jsonOut = `{
  <span class="k">"from"</span>: "noreply@github.com",
  <span class="k">"subject"</span>: "[GitHub] Verify your email",
  <span class="k">"otp"</span>: {
    <span class="k">"codes"</span>: [<span class="k">"59162834"</span>],
    <span class="k">"links"</span>: [
      <span class="k">"https://github.com/…/confirm_verification/…"</span>
    ]
  }
}`;

// FAQ — visible section below AND FAQPage JSON-LD (Google requires the marked-up
// content to be on the page, so both render from this single source).
const faq = [
  {
    q: t.faq_q_1,
    a: t.faq_a_1,
    link: {
      href: pageUrl(locale, 'pricing'),
      text: t.faq_link_1_text,
      strong: t.faq_link_1_strong,
    },
  },
  {
    q: t.faq_q_2,
    a: t.faq_a_2,
  },
  {
    q: t.faq_q_3,
    a: t.faq_a_3,
  },
  {
    q: t.faq_q_4,
    a: t.faq_a_4,
  },
  {
    q: t.faq_q_5,
    a: t.faq_a_5,
  },
  {
    q: t.faq_q_6,
    a: t.faq_a_6,
  },
  {
    q: t.faq_q_7,
    a: t.faq_a_7,
  },
  {
    q: t.faq_q_8,
    a: t.faq_a_8,
  },
  {
    q: t.faq_q_9,
    a: t.faq_a_9,
  },
];

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'openagent.email',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (Docker)',
  description: t.jsonld_software_description,
  url: 'https://openagent.email',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: 'https://github.com/openagentemail/openagentemail',
  downloadUrl: 'https://www.npmjs.com/package/@openagentemail/mcp',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<!doctype html>
<html lang={htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title set:html={t.meta_title}></title>
    <meta
      name="description"
      content={t.meta_description}
    />
    <link rel="canonical" href={currentUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={t.og_title} />
    <meta
      property="og:description"
      content={t.og_description}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content="https://openagent.email/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://openagent.email/og.png" />
    <JsonLd data={softwareJsonLd} />
    <JsonLd data={faqJsonLd} />
    <script defer src="https://stats.openagent.email/script.js" data-website-id="86e6eaf7-473c-4c8d-a9bf-ea48c13742c5"></script>
    <noscript>
      <style is:global>
        .reveal { opacity: 1; transform: none; }
        .stagger { opacity: 1; }
      </style>
    </noscript>
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="brand" href={pageUrl(locale, 'index')} aria-label={t.nav_brand_aria}>
          <img src="/favicon.svg" alt="" />
          <span>openagent<span class="gold">.email</span></span>
        </a>
        <span class="spacer"></span>
        <a class="navlink" href={pageUrl(locale, 'compare')}>{t.nav_compare}</a>
        <a class="navlink" href={pageUrl(locale, 'pricing')}>{t.nav_pricing}</a>
        <a class="navlink" href="https://github.com/openagentemail/openagentemail">{t.nav_github}</a>
        <a class="navlink" href={pageUrl(locale, '/docs/')}>{t.nav_docs}</a>
        <LangSwitcher currentLocale={locale} page="index" />
      </div>
    </nav>

    <!-- 1 ── HERO ──────────────────────────────────────────────────────── -->
    <header class="hero" data-envelope-root>
      <div class="aurora aurora-1"></div>
      <div class="aurora aurora-2"></div>
      <div class="aurora aurora-3"></div>
      <EnvelopeOrbit />
      <div class="wrap">
        <p class="kicker stagger stagger-1">{t.hero_kicker}</p>
        <h1 class="stagger stagger-2">
          <Fragment set:html={t.hero_title_line1} /><br />
          <span class="foil-wrap"><span class="foil-stroke" aria-hidden="true">{t.hero_title_line2}</span><span class="foil foil-fill">{t.hero_title_line2}</span></span>
        </h1>
        <p class="sub stagger stagger-3">
          {t.hero_sub}
        </p>
        <ul class="hero-chips stagger stagger-3" aria-label={t.hero_chips_aria}>
          <li>{t.hero_chip_1}</li>
          <li>{t.hero_chip_2}</li>
          <li>{t.hero_chip_3}</li>
        </ul>
        <p class="hero-docs stagger stagger-3">
          <a class="manual-link" href={pageUrl(locale, '/docs/quickstart/')}>{t.hero_doc_quickstart}</a>
          <a class="manual-link" href={pageUrl(locale, '/docs/guides/connect-your-agent/')}>{t.hero_doc_connect}</a>
        </p>
        <div class="cta-row stagger stagger-4">
          <a class="btn btn-gold" href="https://github.com/openagentemail/openagentemail">{t.hero_cta_github}</a>
          <a class="btn btn-ghost" href="#demo">{t.hero_cta_demo}</a>
          <div class="cmdline">
            <span class="cmd">npx -y @openagentemail/setup</span>
            <button class="copy-btn" data-copy="npx -y @openagentemail/setup" data-copied-label={t.script_copied} data-reset-label={t.script_copy}><span class="copy-label">{t.hero_copy_btn}</span></button>
          </div>
          <a
            class="npm-badge"
            href="https://www.npmjs.com/package/@openagentemail/setup"
            target="_blank"
            rel="noopener"
            title={t.hero_npm_badge_title}
          >
            <img src="https://img.shields.io/npm/v/@openagentemail/setup?logo=npm" alt={t.hero_npm_badge_alt} />
          </a>
        </div>
        <p class="manual-row stagger stagger-5">
          <a class="manual-link" href={pageUrl(locale, 'pricing')}>{t.hero_novps_prefix}{t.hero_novps_link}</a>
        </p>
      </div>
    </header>

    <!-- 1.5 ── WHAT IS (quotable AEO definition; visible text, not metadata) -->
    <section class="what-is" aria-labelledby="what-is-heading">
      <div class="wrap">
        <h2 id="what-is-heading" class="reveal">{t.what_is_title}</h2>
        <p class="reveal">
          {t.what_is_p1}
        </p>
      </div>
    </section>

    <!-- 2 ── WORKS WITH (marquee) ──────────────────────────────────────── -->
    <div class="logos">
      <p>{t.marquee_title}</p>
      <div class="marquee">
        <div class="marquee-track">
          <span class="item"><img src="/icons/claude.svg" alt="" />{t.marquee_claude}</span>
          <span class="item"><img src="/icons/cursor.svg" alt="" />{t.marquee_cursor}</span>
          <span class="item"><img src="/icons/windsurf.svg" alt="" />{t.marquee_windsurf}</span>
          <span class="item"><img src="/icons/docker.svg" alt="" />{t.marquee_docker}</span>
          <span class="item">{t.marquee_kimi}</span>
          <span class="item">{t.marquee_mcp}</span>
          <span class="item">{t.marquee_rest}</span>
          <span class="item" aria-hidden="true"><img src="/icons/claude.svg" alt="" />{t.marquee_claude}</span>
          <span class="item" aria-hidden="true"><img src="/icons/cursor.svg" alt="" />{t.marquee_cursor}</span>
          <span class="item" aria-hidden="true"><img src="/icons/windsurf.svg" alt="" />{t.marquee_windsurf}</span>
          <span class="item" aria-hidden="true"><img src="/icons/docker.svg" alt="" />{t.marquee_docker}</span>
          <span class="item" aria-hidden="true">{t.marquee_kimi}</span>
          <span class="item" aria-hidden="true">{t.marquee_mcp}</span>
          <span class="item" aria-hidden="true">{t.marquee_rest}</span>
        </div>
      </div>
    </div>

    <!-- 2.5 ── CONNECT YOUR AGENT ── -->
    <section id="connect">
      <div class="wrap">
        <p class="kicker reveal">{t.connect_kicker}</p>
        <h2 class="reveal">{t.connect_title}</h2>
        <p class="sub reveal">
          {t.connect_sub}
        </p>
        <div class="cta-row reveal" style="margin-top: 1.75rem">
          <a class="btn btn-gold" href={pageUrl(locale, '/docs/guides/connect-your-agent/')}>{t.connect_cta_guide}</a>
          <a class="btn btn-ghost" href={pageUrl(locale, '/docs/reference/mcp-clients/')}>{t.connect_cta_configs}</a>
        </div>
      </div>
    </section>

    <!-- 3 ── TERMINAL DEMO ─────────────────────────────────────────────── -->
    <section id="demo">
      <div class="wrap">
        <p class="kicker reveal">{t.demo_kicker}</p>
        <h2 class="reveal">{t.demo_title}</h2>
        <p class="sub reveal">
          {t.demo_sub}
        </p>
        <div class="terminal reveal" style="margin-top: 2.5rem">
          <div class="bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="title">{t.demo_term_title}</span>
          </div>
          <pre id="term" aria-label={t.demo_term_aria}><span id="term-out"></span><span class="cursor" id="term-cursor"></span></pre>
        </div>
      </div>
    </section>

    <!-- 3.5 ── REAL MAIL CARDS (fan) ───────────────────────────────────── -->
    <section>
      <div class="wrap">
        <p class="kicker reveal">{t.fan_kicker}</p>
        <h2 class="reveal">{t.fan_title_1}<br />{t.fan_title_2}</h2>
        <p class="sub reveal">
          {t.fan_sub}
        </p>
        <div class="fan reveal">
          <div class="fan-card f-left">
            <div class="mail-head"><b>{t.fan_card_head_from}</b> noreply@github.com<br /><b>{t.fan_card_head_subject}</b> [GitHub] Your launch code</div>
            <div class="mail-body">
              Here's your GitHub launch code, @agent — paste it to finish signing up. It expires in 10 minutes.
            </div>
            <span class="code-chip">59162834</span>
            <div class="extracted">otp.codes → ["59162834"] ✓</div>
          </div>
          <div class="fan-card f-mid">
            <div class="mail-head"><b>{t.fan_card_head_from}</b> service@notice.aliyun.com<br /><b>{t.fan_card_head_subject}</b> 【阿里云】验证码</div>
            <div class="mail-body">
              您正在注册阿里云账号，验证码如下，请在 15 分钟内完成验证。工作人员不会索取验证码，请勿泄露。
            </div>
            <span class="code-chip">509227</span>
            <div class="extracted">otp.codes → ["509227"] ✓</div>
          </div>
          <div class="fan-card f-right">
            <div class="mail-head"><b>{t.fan_card_head_from}</b> no-reply@accounts.google.com<br /><b>{t.fan_card_head_subject}</b> Your Google verification code</div>
            <div class="mail-body">
              G-482916 is your Google verification code. Don't share it with anyone.
            </div>
            <span class="code-chip">G-482916</span>
            <div class="extracted">otp.codes → ["482916"] ✓</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 ── FEATURES ──────────────────────────────────────────────────── -->
    <section>
      <div class="wrap">
        <p class="kicker reveal">{t.why_kicker}</p>
        <h2 class="reveal">{t.why_title_1}<br />{t.why_title_2}</h2>
        <div class="why-groups" style="margin-top: 3rem">
          <div class="why-group"><h3 class="why-heading reveal">{t.why_heading_human}</h3><div class="why-grid">
          <div class="card card-cockpit reveal">
            <div class="card-copy">
              <span class="num">{t.card_1_num}</span>
              <h3>{t.card_1_title}</h3>
              <p>{t.card_1_desc}</p>
            </div>
            <div class="cockpit-stage">
              <div class="cockpit-shot">
                <img
                  src="/images/dashboard-overview.webp"
                  width="1440"
                  height="900"
                  alt={t.card_1_img_alt}
                />
              </div>
            </div>
          </div>
          <div class="card reveal">
            <span class="num">{t.card_2_num}</span>
            <h3>{t.card_2_title}</h3>
            <p>{t.card_2_desc}</p>
            <div class="card-viz" aria-hidden="true">
              <svg class="viz-phone" viewBox="0 0 220 92" role="img">
                <rect class="phone-frame" x="6" y="8" width="36" height="76" rx="6" />
                <rect x="18" y="12" width="12" height="3" rx="1.5" fill="rgba(255,255,255,0.12)" />
                <path d="M14 28 h20 v12 h-20 z" fill="none" stroke="#fbbf24" stroke-width="1.4" />
                <path d="M15 29.5 24 36l9-6.5" fill="none" stroke="#fbbf24" stroke-width="1.3" stroke-linecap="round" />
                <text class="tier-label" x="52" y="18">{t.card_2_tier_1}</text>
                <path d="M52 26 h14 v9 h-14 z" fill="none" stroke="currentColor" stroke-width="1.1" />
                <path d="M53 27.2 59 31.5 65 27.2" fill="none" stroke="currentColor" stroke-width="1" />
                <text class="tier-label" x="52" y="48">{t.card_2_tier_2}</text>
                <rect x="52" y="52" width="58" height="6" rx="1" fill="rgba(255,255,255,0.08)" />
                <text class="tier-sub" x="54" y="57">{t.card_2_tier_2_sub}</text>
                <text class="tier-label" x="124" y="48">{t.card_2_tier_3}</text>
                <rect x="124" y="52" width="86" height="22" rx="2" fill="rgba(255,255,255,0.06)" stroke="rgba(251,191,36,0.28)" />
                <text class="tier-sub" x="128" y="61">{t.card_2_tier_3_sub}</text>
                <circle class="otp-dot" cx="132" cy="68" r="2.1" />
                <circle class="otp-dot" cx="139" cy="68" r="2.1" />
                <circle class="otp-dot" cx="146" cy="68" r="2.1" />
                <text class="tier-sub" x="154" y="70" fill="#fbbf24">{t.card_2_otp_label}</text>
              </svg>
            </div>
          </div>
          <div class="card reveal">
            <span class="num">{t.card_3_num}</span>
            <h3>{t.card_3_title}</h3>
            <p>{t.card_3_desc}</p>
            <div class="card-viz" aria-hidden="true">
              <svg class="viz-sent" viewBox="0 0 220 88" role="img">
                <path class="flight" d="M18 58 C 48 18, 92 8, 132 22" />
                <g class="env-fly">
                  <rect x="126" y="10" width="22" height="15" rx="2" fill="#14161f" stroke="#fbbf24" stroke-width="1.3" />
                  <path d="M127.5 12.2 137 19.2 146.5 12.2" fill="none" stroke="#fbbf24" stroke-width="1.2" />
                </g>
                <line class="ledger-line" x1="10" y1="70" x2="210" y2="70" />
                <text class="ledger" x="12" y="82">{t.card_3_ledger_sample}</text>
                <text class="ledger ok" x="176" y="82">{t.card_3_ledger_status}</text>
              </svg>
            </div>
          </div>
          </div></div>
          <div class="why-group"><h3 class="why-heading reveal">{t.why_heading_agent}</h3><div class="why-grid">
          <div class="card reveal">
            <span class="num">{t.card_4_num}</span>
            <h3>{t.card_4_title}</h3>
            <p>{t.card_4_desc}</p>
            <FeatureViz kind="mcp" />
          </div>
          <div class="card reveal">
            <span class="num">{t.card_5_num}</span>
            <h3>{t.card_5_title}</h3>
            <p><Fragment set:html={t.card_5_desc} /></p>
            <FeatureViz kind="tasks" />
          </div>
          <div class="card reveal">
            <span class="num">{t.card_6_num}</span>
            <h3>{t.card_6_title}</h3>
            <p><Fragment set:html={t.card_6_desc} /></p>
            <FeatureViz kind="identities" />
          </div>
          <div class="card reveal">
            <span class="num">{t.card_7_num}</span>
            <h3>{t.card_7_title}</h3>
            <p><Fragment set:html={t.card_7_desc} /></p>
            <FeatureViz kind="tokens" />
          </div>
          <div class="card reveal">
            <span class="num">{t.card_8_num}</span>
            <h3>{t.card_8_title}</h3>
            <p>{t.card_8_desc}</p>
            <FeatureViz kind="otp" />
          </div>
          </div></div>
          <div class="why-group"><h3 class="why-heading reveal">{t.why_heading_box}</h3><div class="why-grid">
          <div class="card reveal">
            <span class="num">{t.card_9_num}</span>
            <h3>{t.card_9_title}</h3>
            <p><Fragment set:html={t.card_9_desc} /></p>
            <FeatureViz kind="safety" labels={{ safety: t.viz_safety }} />
          </div>
          <div class="card reveal">
            <span class="num">{t.card_10_num}</span>
            <h3>{t.card_10_title}</h3>
            <p>{t.card_10_desc}</p>
            <FeatureViz kind="relay" />
          </div>
          <div class="card reveal">
            <span class="num">{t.card_11_num}</span>
            <h3>{t.card_11_title}</h3>
            <p><Fragment set:html={t.card_11_desc} /></p>
            <FeatureViz kind="dns" />
          </div>
          </div></div>
        </div>
      </div>
    </section>

    <StampWall labels={{
      kicker: t.stamp_kicker,
      title: t.stamp_title,
      mcpCaption: t.stamp_caption_mcp,
      rfcCaption: t.stamp_caption_rfc,
      a2aCaption: t.stamp_caption_a2a,
      a2aNote: t.stamp_note_a2a,
      ercCaption: t.stamp_caption_erc,
    }} />

    <!-- 5 ── HOW IT WORKS ──────────────────────────────────────────────── -->
    <section>
      <div class="wrap">
        <p class="kicker reveal">{t.steps_kicker}</p>
        <h2 class="reveal">{t.steps_title_1}<br />{t.steps_title_2}</h2>
        <div class="steps" style="margin-top: 2.5rem" id="steps">
          <div class="step reveal">
            <h3>{t.step_1_title}</h3>
            <p>{t.step_1_desc}</p>
            <code>docker compose up -d</code>
          </div>
          <div class="step reveal">
            <h3>{t.step_2_title}</h3>
            <p>{t.step_2_desc}</p>
            <code>./deploy/dns-records.sh</code>
          </div>
          <div class="step reveal">
            <h3>{t.step_3_title}</h3>
            <p>{t.step_3_desc}</p>
            <code>./deploy/doctor.sh</code>
          </div>
          <div class="step reveal">
            <h3>{t.step_4_title}</h3>
            <p>{t.step_4_desc}</p>
            <code>POST /v1/identities → fox-k7d2@yourdomain</code>
          </div>
          <div class="step reveal">
            <h3>{t.step_5_title}</h3>
            <p>{t.step_5_desc}</p>
            <code>mail_wait_for → otp.codes[0]</code>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 ── STATS + CAPABILITIES ──────────────────────────────────────── -->
    <section>
      <div class="wrap">
        <div class="stats" style="grid-template-columns: 1fr; max-width: 18rem; margin-inline: auto;">
          <div class="stat reveal"><div class="n" data-count={MCP_TOOLS.length}>0</div><div class="l">{t.stat_mcp_tools}</div></div>
        </div>
        <div class="caplist reveal">
          <h3>{t.cap_rest_title}</h3>
          <ul>
            <li><code>{t.cap_rest_1}</code></li>
            <li><code>{t.cap_rest_2}</code></li>
            <li><code>{t.cap_rest_3}</code></li>
            <li><code>{t.cap_rest_4}</code></li>
            <li><code>{t.cap_rest_5}</code></li>
            <li><code>{t.cap_rest_6}</code></li>
            <li><code>{t.cap_rest_7}</code></li>
            <li><code>{t.cap_rest_8}</code></li>
            <li><code>{t.cap_rest_9}</code></li>
            <li><code>{t.cap_rest_10}</code></li>
            <li><code>{t.cap_rest_11}</code></li>
            <li><code>{t.cap_rest_12}</code></li>
            <li><code>{t.cap_rest_13}</code></li>
            <li><code>{t.cap_rest_14}</code></li>
            <li><code>{t.cap_rest_15}</code></li>
            <li><code>{t.cap_rest_16}</code></li>
