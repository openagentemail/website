---
// 页尾「信封寄出」特效，双形态：
//  - lottie（首页/compare/pricing 页尾 CTA）：email-sent.json 金色动画，
//    播放器懒加载逻辑在本组件内自足，任何页面引用即生效
//  - 默认：静态纸飞机线稿
interface Props { lottie?: boolean; class?: string }
const { lottie = false, class: className = '' } = Astro.props;
---

{lottie ? (
  <div class:list={['lottie-final', className]} aria-hidden="true"></div>
) : (
  <svg class:list={['paper-plane', className]} viewBox="0 0 220 78" aria-hidden="true" fill="none">
    <path d="m24 39 166-27-55 54-18-23-31-4Z" fill="#14161f" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <path d="m117 43 73-31-55 54-2-30" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <path d="M44 58c35 8 66 6 91-3" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 5" stroke-linecap="round" />
  </svg>
)}

<style>
  .paper-plane { display:block; width:10rem; height:auto; margin:2rem auto 1rem; color:var(--gold); filter:drop-shadow(0 8px 15px rgba(251,191,36,.16)); }
</style>

<script>
  // ── final CTA lottie（原 index.astro 内联脚本，抽入组件；懒加载、reduced-motion 降级）──
  // LottieFiles "contact-email" by Deedy Intern Team (Lottie Simple License),
  // recolored to brand gold. Player: lottie-web v5.13.0 (MIT), vendored,
  // loaded only when a .lottie-final approaches the viewport.
  (function initFinalLottie() {
    const hosts = document.querySelectorAll('.lottie-final');
    if (!hosts.length) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let started = false;

    const start = () => {
      if (started || !window.lottie) return;
      started = true;
      hosts.forEach((host) => {
        const anim = window.lottie.loadAnimation({
          container: host,
          renderer: 'svg',
          loop: true,
          autoplay: false,
          path: '/animations/email-sent.json',
        });
        if (reduce) {
          // static golden frame, no motion — content still complete
          anim.addEventListener('DOMLoaded', () => anim.goToAndStop(60, true));
        } else {
          new IntersectionObserver((entries) => {
            entries.forEach((en) => (en.isIntersecting ? anim.play() : anim.pause()));
          }, { threshold: 0.15 }).observe(host);
        }
      });
    };
    const load = () => {
      if (window.lottie) return start();
      const s = document.createElement('script');
      s.src = '/vendor/lottie_svg.min.js';
      s.onload = start;
      document.head.appendChild(s);
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((en) => en.isIntersecting)) { io.disconnect(); load(); }
    }, { rootMargin: '400px' }).observe(hosts[0]);
  })();
</script>
