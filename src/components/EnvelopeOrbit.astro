---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<div class:list={['envs', { 'envs-compact': compact }]} data-envelope-orbit aria-hidden="true">
  <svg class="env" data-x={compact ? '78' : '86'} data-y={compact ? '24' : '16'} data-rot="6" style={compact ? 'width: 86px' : 'width: 120px'} viewBox="0 0 64 64" fill="none">
    <rect x="6" y="14" width="52" height="38" rx="6" stroke="#fbbf24" stroke-width="3" fill="#14161f" />
    <path d="M9 19 32 36l23-17" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <svg class="env" data-x={compact ? '61' : '68'} data-y={compact ? '55' : '56'} data-rot="-8" style={compact ? 'width: 56px' : 'width: 74px'} viewBox="0 0 64 64" fill="none">
    <rect x="6" y="14" width="52" height="38" rx="6" stroke="#fbbf24" stroke-width="3" fill="#14161f" />
    <path d="M9 19 32 36l23-17" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <svg class="env" data-x={compact ? '89' : '50'} data-y={compact ? '68' : '72'} data-rot="11" style={compact ? 'width: 42px' : 'width: 52px'} viewBox="0 0 64 64" fill="none">
    <rect x="6" y="14" width="52" height="38" rx="6" stroke="#fbbf24" stroke-width="3" fill="#14161f" />
    <path d="M9 19 32 36l23-17" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</div>

<style>
  .envs-compact { position: relative; height: 6rem; margin: -1.4rem 0 .2rem; overflow: visible; }
  .envs-compact::after {
    content: ''; position: absolute; right: 2%; top: 10%; width: 18rem; height: 7rem;
    background: radial-gradient(ellipse, rgba(251,191,36,.11), transparent 68%);
    filter: blur(10px); pointer-events: none;
  }
  .envs-compact .env { left: 0; top: 0; }
  @media (max-width: 900px) { .envs-compact { display: block; } }
  @media (prefers-reduced-motion: reduce) { .envs-compact .env { opacity: .88; } }
</style>

<script>
  // 首页与内页页首共用同一套 spring-follow；每组信封只响应自己的页首根节点。
  document.querySelectorAll('[data-envelope-orbit]').forEach((orbit) => {
    if (orbit.dataset.envelopeReady) return;
    orbit.dataset.envelopeReady = 'true';
    const root = orbit.closest('[data-envelope-root]') || orbit.closest('.hero');
    const els = [...orbit.querySelectorAll('.env')];
    if (!root || els.length === 0) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const FOLLOW_R = 460;

    let rect = root.getBoundingClientRect();
    const remeasure = () => { rect = root.getBoundingClientRect(); };
    addEventListener('resize', remeasure);
    addEventListener('scroll', remeasure, { passive: true });

    const specs = els.map((el, i) => ({
      el,
      w: el.getBoundingClientRect().width,
      h: el.getBoundingClientRect().height,
      px: parseFloat(el.dataset.x) / 100,
      py: parseFloat(el.dataset.y) / 100,
      rot: parseFloat(el.dataset.rot || '0'),
      phase: i * 2.1,
      x: 0,
      y: 0,
    }));
    const homeX = (s) => s.px * rect.width - s.w / 2;
    const homeY = (s) => s.py * rect.height - s.h / 2;

    if (reduce) {
      for (const s of specs) {
        s.el.style.transform = `translate(${homeX(s)}px, ${homeY(s)}px) rotate(${s.rot}deg)`;
      }
      return;
    }

    for (const s of specs) {
      s.x = homeX(s) + 180;
      s.y = homeY(s) - 110;
      s.el.style.transform = `translate(${s.x}px, ${s.y}px) rotate(${s.rot}deg)`;
    }
    els.forEach((el, i) => setTimeout(() => { el.style.opacity = '1'; }, 250 + i * 200));

    let framesRan = 0;
    setTimeout(() => {
      if (framesRan > 0) return;
      for (const s of specs) {
        s.el.style.transform = `translate(${homeX(s)}px, ${homeY(s)}px) rotate(${s.rot}deg)`;
      }
    }, 1500);

    let mouse = null;
    root.addEventListener('mousemove', (event) => {
      mouse = { x: event.clientX - rect.left, y: event.clientY - rect.top };
    });
    root.addEventListener('mouseleave', () => { mouse = null; });

    function frame(timeStamp) {
      framesRan++;
      const time = timeStamp / 1000;
      let follower = null;
      if (mouse && finePointer) {
        let best = FOLLOW_R;
        for (const s of specs) {
          const distance = Math.hypot(mouse.x - homeX(s), mouse.y - homeY(s));
          if (distance < best) { best = distance; follower = s; }
        }
      }
      for (const s of specs) {
        const bob = Math.sin(time * 1.5 + s.phase) * 6;
        let targetX;
        let targetY;
        if (s === follower) {
          targetX = mouse.x - 160;
          targetY = mouse.y - 70 + bob * 0.4;
        } else {
          targetX = homeX(s);
          targetY = homeY(s) + bob;
        }
        const spring = s === follower ? 0.085 : 0.05;
        const previousX = s.x;
        s.x += (targetX - s.x) * spring;
        s.y += (targetY - s.y) * spring;
        const velocityX = s.x - previousX;
        const tilt = s === follower ? Math.max(-16, Math.min(16, velocityX * 1.1)) : 0;
        s.el.style.transform = `translate(${s.x}px, ${s.y}px) rotate(${s.rot + tilt}deg)`;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  });
</script>
