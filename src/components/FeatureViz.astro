---
interface Props { kind: 'mcp' | 'tasks' | 'identities' | 'tokens' | 'otp' | 'safety' | 'relay' | 'dns' }
const { kind } = Astro.props;
---

<div class="card-viz feature-viz" aria-hidden="true">
  <svg viewBox="0 0 220 78" fill="none">
    <rect class="viz-frame" x="1" y="1" width="218" height="76" rx="8" />

    {kind === 'mcp' && <>
      <rect class="pane" x="10" y="9" width="82" height="59" rx="6" />
      <g class="icon" transform="translate(28 14) scale(1.65)">
        <path d="m10.852 14.772-.383.923"/><path d="M13.148 14.772a3 3 0 1 0-2.296-5.544l-.383-.923"/><path d="m13.148 9.228.383-.923"/><path d="m13.53 15.696-.382-.924a3 3 0 1 1-2.296-5.544"/><path d="m14.772 10.852.923-.383"/><path d="m14.772 13.148.923.383"/><path d="M4.5 10H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-.5"/><path d="M4.5 14H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-.5"/><path d="M6 18h.01M6 6h.01"/><path d="m9.228 10.852-.923-.383M9.228 13.148l-.923.383"/>
      </g>
      <text class="label strong" x="38" y="63">stdio</text>
      <path class="swap" d="M99 31h20m-5-5 5 5-5 5m5 13H99m5-5-5 5 5 5" />
      <rect class="pane" x="128" y="9" width="82" height="59" rx="6" />
      <g class="icon" transform="translate(145 13) scale(1.7)">
        <path d="m10.852 19.772-.383.924M13.148 14.228l.383-.923"/><path d="M13.148 19.772a3 3 0 1 0-2.296-5.544l-.383-.923"/><path d="m13.53 20.696-.382-.924a3 3 0 1 1-2.296-5.544"/><path d="m14.772 15.852.923-.383M14.772 18.148l.923.383"/><path d="M4.2 15.1a7 7 0 1 1 9.93-9.858A7 7 0 0 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.2"/><path d="m9.228 15.852-.923-.383M9.228 18.148l-.923.383"/>
      </g>
      <text class="label strong" x="156" y="63">HTTPS</text>
    </>}

    {kind === 'tasks' && <>
      <g class="icon" transform="translate(20 3) scale(2.85)">
        <circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9M12 12v3"/>
      </g>
      <path class="flow-line" d="M88 27h110M192 22l6 5-6 5M88 52h110M192 47l6 5-6 5" />
      <circle class="status-dot" cx="103" cy="27" r="3"/><circle class="status-dot live" cx="103" cy="52" r="3"/>
      <text class="label strong" x="112" y="30">submitted</text><text class="label strong" x="112" y="55">working</text>
    </>}

    {kind === 'identities' && <>
      <g class="icon hero-icon" transform="translate(35 14) scale(2.05)">
        <circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>
      </g>
      <path class="join" d="M100 39h17" />
      <g class="icon hero-icon" transform="translate(122 13) scale(2.1)"><path d="M6 16c5 0 7-8 12-8a4 4 0 0 1 0 8c-5 0-7-8-12-8a4 4 0 1 0 0 8"/></g>
      <text class="label" x="76" y="68">anything@yourdomain</text>
    </>}

    {kind === 'tokens' && <>
      <g class="icon" transform="translate(23 5) scale(2.6)"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></g>
      <g class="icon faint" transform="translate(132 18) scale(1.55)"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></g>
      <path class="scope-line" d="M111 39h18"/><text class="label strong" x="166" y="43">fox-k7d2</text>
    </>}

    {kind === 'otp' && <>
      <g class="icon" transform="translate(23 12) scale(2.05)"><path d="M22 12.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h7.5"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><circle cx="18" cy="18" r="3"/><path d="m22 22-1.5-1.5"/></g>
      <path class="extract" d="M91 39h30m-6-6 6 6-6 6"/>
      <g class="icon" transform="translate(139 20) scale(2.2)"><path d="M12 10v4M10 13l4-2M10 11l4 2M5 10v4M3 13l4-2M3 11l4 2M19 10v4M17 13l4-2M17 11l4 2"/></g>
      <text class="label strong" x="148" y="63">OTP</text>
    </>}

    {kind === 'safety' && <>
      <g class="icon hero-icon" transform="translate(20 6) scale(2.65)"><path d="M4 12v4h16v-4H4M6 16v4h4v-4m0-4V6L8 4 6 6v6M14 16v4h4v-4m0-4V6l-2-2-2 2v6"/></g>
      <g class="icon badge-icon" transform="translate(149 16) scale(1.9)"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></g>
      <text class="label" x="20" y="69">20/h · 30d · MCP fence</text>
    </>}

    {kind === 'relay' && <>
      <g class="icon hero-icon" transform="translate(74 6) scale(2.7)"><path d="m10.586 5.414-5.172 5.172M18.586 13.414l-5.172 5.172M6 12h12"/><circle cx="12" cy="20" r="2"/><circle cx="12" cy="4" r="2"/><circle cx="20" cy="12" r="2"/><circle cx="4" cy="12" r="2"/></g>
      <text class="node-label" x="94" y="8">VPS</text><text class="node-label" x="29" y="43">SES</text><text class="node-label" x="161" y="43">SMTP</text>
    </>}

    {kind === 'dns' && <>
      <g class="icon" transform="translate(28 13) scale(2.05)"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3M5 6v4M19 14v4M10 2v2M7 8H3M21 16h-4M11 3H9"/></g>
      <path class="join" d="M92 39h22"/>
      <g class="icon" transform="translate(131 13) scale(2.05)"><path d="M11 2v2M5 2v2M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/></g>
      <text class="label strong" x="67" y="69">wizard</text><text class="label strong" x="151" y="69">doctor</text>
    </>}
  </svg>
</div>

<style>
  .feature-viz svg { color: var(--gold); overflow: visible; }
  .viz-frame { fill: #14161f; stroke: rgba(251,191,36,.2); }
  .icon { stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
  .icon :is(path,circle,rect) { vector-effect: non-scaling-stroke; }
  .icon.faint { opacity: .7; }
  .pane { fill: rgba(255,255,255,.022); stroke: rgba(251,191,36,.34); }
  .swap,.flow-line,.join,.scope-line,.extract { stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
  .flow-line,.scope-line { opacity: .55; stroke-dasharray: 3 3; }
  .status-dot { fill: #14161f; stroke: currentColor; }
  .status-dot.live { fill: currentColor; }
  .label,.node-label { fill: var(--ink-faint); font: 7px var(--mono); }
  .label.strong,.node-label { fill: var(--gold-soft); }
  .node-label { font-size: 7.5px; font-weight: 700; letter-spacing: .04em; }
</style>
