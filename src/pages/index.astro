    <script>
      import { pressPostmark } from '../scripts/postmark.js';

      // ── terminal typing loop ──────────────────────────────────────────
      const SCRIPT = [
        { t: 'cmd',  text: '$ docker compose up -d\n', speed: 34 },
        { t: 'ok',   text: ' ✔ openagent-mailserver  Healthy\n ✔ openagent-api         Healthy\n\n', speed: 8 },
        { t: 'cmd',  text: '$ curl -X POST $API/v1/identities -d \'{"name":"signup-bot"}\'\n', speed: 26 },
        { t: 'json', text: ' {"address":"fox-k7d2@openagent.email","token":"oa_8f3k…"}\n\n', speed: 10 },
        { t: 'cmd',  text: '$ agent: mail_wait_for(subjectContains: "verify")\n', speed: 26 },
        { t: 'wait', text: ' ⏳ waiting for mail', speed: 30 },
        { t: 'wait', text: ' …', speed: 400 },
        { t: 'ok',   text: '\n 📩 new mail from noreply@github.com\n', speed: 12 },
        { t: 'json', text: ' {"otp":{"codes":["59162834"],"links":["https://github.com/…/confirm_verification/…"]}}\n\n', speed: 8 },
        { t: 'dim',  text: ' # code extracted. agent proceeds with signup. ✔\n', speed: 16 },
      ];
      const CLS = { cmd: 't-cmd', ok: 't-ok', json: 't-json', dim: 't-dim', wait: 't-wait' };

      function runTerminal() {
        const out = document.getElementById('term-out');
        if (!out) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          out.innerHTML = SCRIPT.map((l) => `<span class="${CLS[l.t]}">${esc(l.text)}</span>`).join('');
          return;
        }
        let line = 0;
        function typeLine() {
          if (line >= SCRIPT.length) {
            setTimeout(() => { out.innerHTML = ''; line = 0; typeLine(); }, 6000);
            return;
          }
          const { t, text, speed } = SCRIPT[line];
          const span = document.createElement('span');
          span.className = CLS[t];
          out.appendChild(span);
          let i = 0;
          (function tick() {
            span.textContent = text.slice(0, ++i);
            if (i < text.length) setTimeout(tick, speed);
            else { line++; setTimeout(typeLine, t === 'cmd' ? 350 : 120); }
          })();
        }
        typeLine();
      }
      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      // ── scroll reveal ─────────────────────────────────────────────────
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      // Fallback: anything already in view at load is shown immediately —
      // covers IO-less environments and avoids a first-paint flash.
      document.querySelectorAll('.reveal').forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
      });

      // ── how-it-works: light the step rail as you scroll ───────────────
      const stepIO = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('lit', e.isIntersecting)),
        { rootMargin: '-35% 0px -35% 0px' },
      );
      document.querySelectorAll('#steps .step').forEach((el) => stepIO.observe(el));

      // ── spotlight + fine-pointer card tilt ────────────────────────────
      const cardFinePointer = window.matchMedia('(pointer: fine)').matches;
      const reduceCardMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.card').forEach((card) => {
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;
        let pointerIsTouch = false;
        let resetTimer = 0;
        const tiltEnabled = cardFinePointer && !reduceCardMotion;

        card.addEventListener(
          'pointermove',
          (ev) => {
            pointerX = ev.clientX;
            pointerY = ev.clientY;
            pointerIsTouch = ev.pointerType === 'touch';
            if (frame) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              const r = card.getBoundingClientRect();
              if (!r.width || !r.height) return;
              const x = Math.max(0, Math.min(r.width, pointerX - r.left));
              const y = Math.max(0, Math.min(r.height, pointerY - r.top));
              card.style.setProperty('--mx', `${x}px`);
              card.style.setProperty('--my', `${y}px`);
              if (pointerIsTouch || !tiltEnabled) return;

              clearTimeout(resetTimer);
              const rx = (7 - (y / r.height) * 14).toFixed(2);
              const ry = (-7 + (x / r.width) * 14).toFixed(2);
              card.classList.remove('tilt-resetting');
              card.classList.add('tilt-active');
              card.style.transform =
                `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg) `
                + 'translateY(var(--card-lift))';
            });
          },
          { passive: true },
        );

        const resetTilt = () => {
          if (!tiltEnabled) return;
          if (frame) {
            cancelAnimationFrame(frame);
            frame = 0;
          }
          clearTimeout(resetTimer);
          card.classList.remove('tilt-active');
          card.classList.add('tilt-resetting');
          card.style.transform =
            'perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0px)';
          resetTimer = window.setTimeout(() => {
            card.classList.remove('tilt-resetting');
            card.style.removeProperty('transform');
          }, 300);
        };
        card.addEventListener('pointerleave', resetTilt);
        card.addEventListener('pointercancel', resetTilt);
      });

      // ── stat counters ─────────────────────────────────────────────────
      const countIO = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          countIO.unobserve(e.target);
          const target = Number(e.target.dataset.count);
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || target === 0) {
            e.target.textContent = String(target);
            return;
          }
          const t0 = performance.now();
          (function step(now) {
            const p = Math.min(1, (now - t0) / 1200);
            e.target.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(step);
          })(t0);
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));

      // ── copy buttons：复制成功 = 盖一枚邮戳，然后按钮进 copied 态 ──────
      // 邮戳实现在 src/scripts/postmark.js，文档站的 copy 按钮共用同一份。
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        // 文案只改 .copy-label 这层，绝不用 btn.textContent（那会连按钮里的东西一起冲掉）
        const label = btn.querySelector('.copy-label') || btn;
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy);
          } catch {
            return; // clipboard blocked — user selects manually
          }
          // 盖章 + copied 态的全部时序（落定 350ms 变绿、1.2s 起淡出、1800ms 还原、
          // 连点收尾、reduced-motion 降级）都在 postmark.js 里，这里只给它文案回调
          pressPostmark(btn, {
            stateClass: 'copied',
            onCopied: () => { label.textContent = 'copied ✓'; },
            onReset: () => { label.textContent = 'copy'; },
          });
        });
      });

      // ── hero envelopes: spring-follow the cursor ─────────────────────
      // Nearest envelope within FOLLOW_R gets attracted and trails the
      // mouse with a laggy spring + velocity tilt; the rest idle-bob at
      // home. Mouse leaves the hero → follower glides back home.
      function initEnvelopes() {
        const hero = document.querySelector('.hero');
        const els = [...document.querySelectorAll('.env')];
        if (!hero || els.length === 0) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(pointer: fine)').matches;
        const FOLLOW_R = 460;

        let rect = hero.getBoundingClientRect();
        const remeasure = () => { rect = hero.getBoundingClientRect(); };
        addEventListener('resize', remeasure);
        addEventListener('scroll', remeasure, { passive: true });

        const specs = els.map((el, i) => ({
          el,
          // NOTE: SVG elements have no offsetWidth — measure via BCR once,
          // before any transform is applied.
          w: el.getBoundingClientRect().width,
          h: el.getBoundingClientRect().height,
          px: parseFloat(el.dataset.x) / 100, // home, as a fraction of hero size
          py: parseFloat(el.dataset.y) / 100,
          rot: parseFloat(el.dataset.rot || '0'),
          phase: i * 2.1,
          x: 0, y: 0,
        }));
        const homeX = (s) => s.px * rect.width - s.w / 2;
        const homeY = (s) => s.py * rect.height - s.h / 2;

        if (reduce) {
          for (const s of specs) {
            s.el.style.transform = `translate(${homeX(s)}px, ${homeY(s)}px) rotate(${s.rot}deg)`;
          }
          return; // CSS forces opacity:1 under reduced-motion
        }

        // entrance: start up-right of home, the spring pulls them in
        for (const s of specs) {
          s.x = homeX(s) + 180;
          s.y = homeY(s) - 110;
          // apply synchronously so the resting spot is never (0,0)
          s.el.style.transform = `translate(${s.x}px, ${s.y}px) rotate(${s.rot}deg)`;
        }
        els.forEach((el, i) => setTimeout(() => { el.style.opacity = '1'; }, 250 + i * 200));

        // watchdog: environments where rAF never fires (some headless
        // renderers) would leave the envelopes frozen — settle them home.
        let framesRan = 0;
        setTimeout(() => {
          if (framesRan > 0) return;
          for (const s of specs) {
            s.el.style.transform = `translate(${homeX(s)}px, ${homeY(s)}px) rotate(${s.rot}deg)`;
          }
        }, 1500);

        let mouse = null;
        hero.addEventListener('mousemove', (e) => {
          mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
        });
        hero.addEventListener('mouseleave', () => { mouse = null; });

        function frame(t) {
          framesRan++;
          const time = t / 1000;
          // pick the attracted envelope: nearest home within radius
          let follower = null;
          if (mouse && finePointer) {
            let best = FOLLOW_R;
            for (const s of specs) {
              const d = Math.hypot(mouse.x - homeX(s), mouse.y - homeY(s));
              if (d < best) { best = d; follower = s; }
            }
          }
          for (const s of specs) {
            const bob = Math.sin(time * 1.5 + s.phase) * 6;
            let tx, ty;
            if (s === follower) {
              // trail behind-left of the cursor so text stays readable
              tx = mouse.x - 160;
              ty = mouse.y - 70 + bob * 0.4;
            } else {
              tx = homeX(s);
              ty = homeY(s) + bob;
            }
            const k = s === follower ? 0.085 : 0.05; // spring stiffness
            const px = s.x;
            s.x += (tx - s.x) * k;
            s.y += (ty - s.y) * k;
            const vx = s.x - px;
            const tilt = s === follower ? Math.max(-16, Math.min(16, vx * 1.1)) : 0;
            s.el.style.transform = `translate(${s.x}px, ${s.y}px) rotate(${s.rot + tilt}deg)`;
          }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
      initEnvelopes();

      // ── final CTA lottie (lazy load, reduced-motion aware) ─────────────
      (function initFinalLottie() {
        const host = document.getElementById('lottie-final');
        if (!host) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let anim = null;
        const start = () => {
          if (anim || !window.lottie) return;
          anim = window.lottie.loadAnimation({
            container: host,
            renderer: 'svg',
            loop: true,
            autoplay: !reduce,
            path: '/animations/email-sent.json',
          });
          if (reduce) {
            // static golden envelope, no motion — content still complete
            anim.addEventListener('DOMLoaded', () => anim.goToAndStop(60, true));
          } else {
            new IntersectionObserver((entries) => {
              entries.forEach((en) => (en.isIntersecting ? anim.play() : anim.pause()));
            }, { threshold: 0.15 }).observe(host);
          }
        };
        const load = () => {
          if (window.lottie) return start();
          const s = document.createElement('script');
          s.src = '/vendor/lottie_svg.min.js';
          s.onload = start;
          document.head.appendChild(s);
        };
        new IntersectionObserver((entries, io) => {
          if (entries.some((en) => en.isIntersecting)) { io.disconnect(); load(); }
        }, { rootMargin: '400px' }).observe(host);
      })();

      runTerminal();
    </script>

