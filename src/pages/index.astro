---
import '../styles/global.css';
import StampWall from '../components/StampWall.astro';
import EnvelopeOrbit from '../components/EnvelopeOrbit.astro';
import FeatureViz from '../components/FeatureViz.astro';
import PaperPlane from '../components/PaperPlane.astro';

const rawMail = `From: noreply@github.com
To: fox-k7d2@yourdomain
Subject: [GitHub] Verify your email

Here's your GitHub launch code:

  <mark>59162834</mark>

Or <mark>verify your email address</mark> directly:
https://github.com/users/…/confirm_
verification/abc123?via_launch_…

This code expires in 10 minutes.`;

const jsonOut = `{
  <span class="k">"from"</span>: "noreply@github.com",
  <span class="k">"subject"</span>: "[GitHub] Verify your email",
  <span class="k">"otp"</span>: {
    <span class="k">"codes"</span>: [<span class="k">"59162834"</span>],
    <span class="k">"links"</span>: [
      <span class="k">"https://github.com/…/confirm_verification/…"</span>
    ]
  }
}`;

// FAQ — visible section below AND FAQPage JSON-LD (Google requires the marked-up
// content to be on the page, so both render from this single source).
const faq = [
  {
    q: 'Is it really free?',
    a: 'Yes — self-hosting is free and unlimited under the Apache-2.0 license: no paid tier, no usage limits, no per-inbox pricing. The only thing you pay for is the server you run it on, and a $5/mo VPS is enough. If you would rather not run a server, Hosted Pro starts at $5/month with a 3-day free trial — see our pricing.',
    aHtml: 'Yes — self-hosting is free and unlimited under the Apache-2.0 license: no paid tier, no usage limits, no per-inbox pricing. The only thing you pay for is the server you run it on, and a $5/mo VPS is enough. If you would rather not run a server, Hosted Pro starts at $5/month with a 3-day free trial — <a href="/pricing">see our <strong>pricing</strong></a>.',
  },
  {
    q: 'How is it different from AgentMail?',
    // BYOC Outposts：邮件内容可留在客户 AWS，但 vendor 控制面仍在 —— 与真自建区分
    a: 'AgentMail is a hosted SaaS product (usage-based pricing), with an enterprise BYOC option (Outposts) that keeps email content in your AWS account while they still run the control plane. openagent.email is Apache-2.0 software you run yourself on any VPS: unlimited inboxes on your own domain, no vendor control plane, and your mail never leaves a machine you own — unless you opt into push tiers 2/3, which relay subject/from or body/OTP via ntfy. See the full comparison at /compare.',
  },
  {
    q: 'Do I need my own domain?',
    a: 'Yes — any domain you own, about $10/year. One domain gives every agent you run its own address (agent1@yourdomain, agent2@yourdomain, …). The docs walk through the DNS records step by step.',
  },
  {
    q: 'What agents and clients does it work with?',
    // 业主逐字：Kimi Code + dated MCP 2026-07-28 + 远程 OAuth + dashboard 可撤销
    a: 'Anything that speaks MCP — Claude Code, Cursor, Kimi Code, and friends — via the @openagentemail/mcp server, current to the dated MCP 2026-07-28 spec. Cloud agents connect over stateless HTTPS with OAuth — protected-resource metadata per RFC 9728 — or a scoped identity token, and every connected OAuth client shows up in the dashboard where you can revoke it. A plain REST API covers everything else.',
  },
  {
    q: 'Will my mail land in spam?',
    a: 'Deliverability depends on your own IP and domain reputation, which the deliverability guide covers: SPF, DKIM and DMARC are set up for you, and you can relay outbound through Amazon SES if your VPS provider blocks port 25.',
  },
  {
    q: 'Is there a UI for humans?',
    // 业主逐字：清掉旧 Dashboard 口径，改成 cockpit 全功能清单
    a: 'Yes — a full cockpit at /ui, not just a viewer. Read every agent inbox in a three-pane mail client with one-click OTP copy, review the 30-day push log with daily summaries and masked sensitive content, nudge or close agent tasks from the work-order board, manage identities, tokens, push tiers, and connected clients, pair your phone by QR code, and audit what agents sent from the Sent folder. Trust this device once, stay signed in for 30 days.',
  },
  // #22 / tasks：agent 间工单交接（服务端戳状态 + 唤醒收单方 + Dashboard 工单视图）
  {
    q: 'Can agents hand work to each other?',
    a: 'Yes. Tasks are email-backed threads between managed identities, with server-stamped states (submitted → working → completed/failed). Creating a task wakes the receiving agent; the dashboard rebuilds each thread into a work-order card with participants, a timeline, and a result block. From the board you can page through history, nudge a stuck task, or close one out.',
  },
  // 业主逐字新增：手机推送 / ntfy 扫码配对 + 三档出境 + 一键撤销
  {
    q: 'Can I get alerts on my phone?',
    a: 'Yes — pair the ntfy app by scanning a QR code from the dashboard, after a one-time ntfy HTTPS setup covered in the phone guide. You pick how much of a message may leave the server per identity: just a ping, masked sender + subject, or body + OTP (tier 3 asks for your explicit risk confirmation, and agents can never raise their own tier). Lost phone? One click revokes it.',
  },
  // #23：source 打标 + MCP 围栏——诚实定性为 defense-in-depth，不是绝对保证
  {
    q: 'Is it safe for an agent to read untrusted email?',
    a: 'Safer than raw MIME with no labels. Every message carries source: internal|external — only all-domain recipients get a server HMAC stamp (X-OA-Mail-Stamp). The MCP layer fences non-internal text/html/snippet so the model sees "this is data, not instructions." That is a hygiene baseline for defense-in-depth, not an absolute guarantee against prompt injection.',
  },
];

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'openagent.email',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (Docker)',
  description:
    'Open-source, self-hosted email for AI agents. Unlimited inboxes on your own domain, with OTP extraction, agent-to-agent tasks, and push notifications built in. REST API and MCP server.',
  url: 'https://openagent.email',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: 'https://github.com/openagentemail/openagentemail',
  downloadUrl: 'https://www.npmjs.com/package/@openagentemail/mcp',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>openagent.email — Self-hosted email for AI agents</title>
    <meta
      name="description"
      content="The open-source, self-hosted alternative to AgentMail. Unlimited agent mailboxes on your own domain — OTP extraction, agent-to-agent tasks, and phone push, over REST and MCP."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content="openagent.email — Self-hosted email for AI agents" />
    <meta
      property="og:description"
      content="Unlimited agent mailboxes on your own domain. REST + MCP. OTP extraction, agent-to-agent tasks, and push notifications. Apache-2.0."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://openagent.email" />
    <meta property="og:image" content="https://openagent.email/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://openagent.email/og.png" />
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script defer src="https://stats.openagent.email/script.js" data-website-id="86e6eaf7-473c-4c8d-a9bf-ea48c13742c5"></script>
    {/* 无 JS：html.no-js 留着，upgrade.css 全局规则让子组件里的 .reveal 也可见。
        is:global 防止 Astro 把选择器编进 index.astro 的 scope（StampWall 吃不到）。 */}
    <noscript>
      <style is:global>
        .reveal { opacity: 1; transform: none; }
        .stagger { opacity: 1; }
      </style>
    </noscript>
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="brand" href="/" aria-label="openagent.email home">
          <img src="/favicon.svg" alt="" />
          <span>openagent<span class="gold">.email</span></span>
        </a>
        <span class="spacer"></span>
        <a class="navlink" href="/compare">Compare</a>
        <a class="navlink" href="/pricing">Pricing</a>
        <a class="navlink" href="https://github.com/openagentemail/openagentemail">GitHub</a>
        <a class="navlink" href="/docs/">Docs</a>
      </div>
    </nav>

    <!-- 1 ── HERO ──────────────────────────────────────────────────────── -->
    <header class="hero" data-envelope-root>
      <div class="aurora aurora-1"></div>
      <div class="aurora aurora-2"></div>
      <div class="aurora aurora-3"></div>
      <EnvelopeOrbit />
      <div class="wrap">
        <p class="kicker stagger stagger-1">Open source · Self-hosted · Apache-2.0</p>
        <h1 class="stagger stagger-2">
          Email for your agents.<br />
          <span class="foil-wrap"><span class="foil-stroke" aria-hidden="true">Owned by you.</span><span class="foil foil-fill">Owned by you.</span></span>
        </h1>
        <p class="sub stagger stagger-3">
          {/* 副标题只加手机推送子句，总长控制在原 +20 字符内 */}
          The open-source alternative to AgentMail. Unlimited real mailboxes for every agent you
          run, on your own domain — over REST and MCP — with OTP and verification-link extraction
          built in — and phone push. One guided command gets you started.
        </p>
        {/* Hero 布局不动：只在副标题下加一排低调小徽章 */}
        <ul class="hero-chips stagger stagger-3" aria-label="Highlights">
          <li>MCP 2026-07-28</li>
          <li>Apache-2.0</li>
          <li>Self-hosted first</li>
        </ul>
        <div class="cta-row stagger stagger-4">
          <a class="btn btn-gold" href="https://github.com/openagentemail/openagentemail">Get started on GitHub</a>
          <a class="btn btn-ghost" href="#demo">See it work ↓</a>
          <div class="cmdline">
            <span class="cmd">npx -y @openagentemail/setup</span>
            <button class="copy-btn" data-copy="npx -y @openagentemail/setup"><span class="copy-label">copy</span></button>
          </div>
          <a
            class="npm-badge"
            href="https://www.npmjs.com/package/@openagentemail/setup"
            target="_blank"
            rel="noopener"
            title="Setup wizard on npm — VPS/domain picks, local demo, and MCP client config"
          >
            <img src="https://img.shields.io/npm/v/@openagentemail/setup?logo=npm" alt="@openagentemail/setup on npm" />
          </a>
        </div>
        <p class="manual-row stagger stagger-5">
          <a class="manual-link" href="/pricing">No VPS? No domain? Skip the setup — join the early-bird plan →</a>
        </p>
      </div>
    </header>

    <!-- 2 ── WORKS WITH (marquee) ──────────────────────────────────────── -->
    <div class="logos">
      <p>WORKS WITH ANY MCP CLIENT — AND ANYTHING THAT CAN CURL</p>
      <div class="marquee">
        <div class="marquee-track">
          <span class="item"><img src="/icons/claude.svg" alt="" />Claude Code</span>
          <span class="item"><img src="/icons/cursor.svg" alt="" />Cursor</span>
          <span class="item"><img src="/icons/windsurf.svg" alt="" />Windsurf</span>
          <span class="item"><img src="/icons/docker.svg" alt="" />Docker</span>
          <span class="item">✦ Kimi Code</span>
          <span class="item">✦ Any MCP client</span>
          <span class="item">✦ Plain REST</span>
          <span class="item" aria-hidden="true"><img src="/icons/claude.svg" alt="" />Claude Code</span>
          <span class="item" aria-hidden="true"><img src="/icons/cursor.svg" alt="" />Cursor</span>
          <span class="item" aria-hidden="true"><img src="/icons/windsurf.svg" alt="" />Windsurf</span>
          <span class="item" aria-hidden="true"><img src="/icons/docker.svg" alt="" />Docker</span>
          <span class="item" aria-hidden="true">✦ Kimi Code</span>
          <span class="item" aria-hidden="true">✦ Any MCP client</span>
          <span class="item" aria-hidden="true">✦ Plain REST</span>
        </div>
      </div>
    </div>

    <!-- 2.5 ── CONNECT YOUR AGENT（小板块：链到文档接入指南，不大改首页） ── -->
    <section id="connect">
      <div class="wrap">
        <p class="kicker reveal">Get connected</p>
        <h2 class="reveal">Connect your agent.</h2>
        <p class="sub reveal">
          CLI, Claude Desktop, or web chat — Claude, ChatGPT, Grok, Mistral Le Chat, and plain REST
          when MCP is not an option. One short guide, step by step.
        </p>
        <div class="cta-row reveal" style="margin-top: 1.75rem">
          <a class="btn btn-gold" href="/docs/guides/connect-your-agent/">Connect your agent →</a>
          <a class="btn btn-ghost" href="/docs/reference/mcp-clients/">CLI / Desktop configs</a>
        </div>
      </div>
    </section>

    <!-- 3 ── TERMINAL DEMO ─────────────────────────────────────────────── -->
    <section id="demo">
      <div class="wrap">
        <p class="kicker reveal">Live workflow</p>
        <h2 class="reveal">From deploy to OTP, in one terminal.</h2>
        <p class="sub reveal">
          This is the actual loop your agent runs: create an identity, trigger a signup, wait for
          the mail, read the code. Typed out for you below — no video, no mockup.
        </p>
        <div class="terminal reveal" style="margin-top: 2.5rem">
          <div class="bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="title">agent@your-vps — openagent.email</span>
          </div>
          <pre id="term" aria-label="Terminal demo"><span id="term-out"></span><span class="cursor" id="term-cursor"></span></pre>
        </div>
      </div>
    </section>

    <!-- 3.5 ── REAL MAIL CARDS (fan) ───────────────────────────────────── -->
    <section>
      <div class="wrap">
        <p class="kicker reveal">Real mail, really parsed</p>
        <h2 class="reveal">The formats your agent<br />will actually meet.</h2>
        <p class="sub reveal">
          Extraction is tested against the mails that real services send — US and Chinese providers
          alike. Hover a card to read it.
        </p>
        <div class="fan reveal">
          <div class="fan-card f-left">
            <div class="mail-head"><b>From:</b> noreply@github.com<br /><b>Subject:</b> [GitHub] Your launch code</div>
            <div class="mail-body">
              Here's your GitHub launch code, @agent — paste it to finish signing up. It expires in 10 minutes.
            </div>
            <span class="code-chip">59162834</span>
            <div class="extracted">otp.codes → ["59162834"] ✓</div>
          </div>
          <div class="fan-card f-mid">
            <div class="mail-head"><b>From:</b> service@notice.aliyun.com<br /><b>Subject:</b> 【阿里云】验证码</div>
            <div class="mail-body">
              您正在注册阿里云账号，验证码如下，请在 15 分钟内完成验证。工作人员不会索取验证码，请勿泄露。
            </div>
            <span class="code-chip">509227</span>
            <div class="extracted">otp.codes → ["509227"] ✓</div>
          </div>
          <div class="fan-card f-right">
            <div class="mail-head"><b>From:</b> no-reply@accounts.google.com<br /><b>Subject:</b> Your Google verification code</div>
            <div class="mail-body">
              G-482916 is your Google verification code. Don't share it with anyone.
            </div>
            <span class="code-chip">G-482916</span>
            <div class="extracted">otp.codes → ["482916"] ✓</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 ── FEATURES ──────────────────────────────────────────────────── -->
    <section>
      <div class="wrap">
        <p class="kicker reveal">Why it exists</p>
        <h2 class="reveal">Everything an agent mailbox needs.<br />Nothing it doesn't.</h2>
        <div class="why-groups" style="margin-top: 3rem">
          <div class="why-group"><h3 class="why-heading reveal">For the human</h3><div class="why-grid">
          {/* 卡1 Dashboard：升主角、2 倍宽。文案逐字锁定。截图用 Overview demo 身份，不用 inbox。 */}
          <div class="card card-cockpit reveal">
            <div class="card-copy">
              <span class="num">01</span>
              <h3>A cockpit for the human</h3>
              <p>Not a read-only status page — a full working deck. Three-pane inbox with one-click OTP copy. A 30-day notification log with daily summaries and masked sensitive content. A task board where you can nudge or close agent work. Identities, tokens, push tiers, and connected clients — all managed from the browser.</p>
            </div>
            <div class="cockpit-stage">
              <div class="cockpit-shot">
                <img
                  src="/images/dashboard-overview.webp"
                  width="1440"
                  height="900"
                  alt="Dashboard Overview: identity table and 30-day stats"
                />
              </div>
            </div>
          </div>
          {/* 卡2 Phone push：文案重写 + 三档出境微缩 */}
          <div class="card reveal">
            <span class="num">02</span>
            <h3>Phone push, with boundaries</h3>
            <p>Pair your phone by scanning a QR code — ten seconds, no command line. Three content tiers decide how much of a message may leave the server: just a ping, masked sender + subject, or body + OTP. Tier 3 needs your explicit risk confirmation, and agents can never raise their own tier. Lost phone? One-click revoke cuts it off immediately.</p>
            <div class="card-viz" aria-hidden="true">
              <svg class="viz-phone" viewBox="0 0 220 92" role="img">
                <rect class="phone-frame" x="6" y="8" width="36" height="76" rx="6" />
                <rect x="18" y="12" width="12" height="3" rx="1.5" fill="rgba(255,255,255,0.12)" />
                <path d="M14 28 h20 v12 h-20 z" fill="none" stroke="#fbbf24" stroke-width="1.4" />
                <path d="M15 29.5 24 36l9-6.5" fill="none" stroke="#fbbf24" stroke-width="1.3" stroke-linecap="round" />
                <text class="tier-label" x="52" y="18">1  ping</text>
                <path d="M52 26 h14 v9 h-14 z" fill="none" stroke="currentColor" stroke-width="1.1" />
                <path d="M53 27.2 59 31.5 65 27.2" fill="none" stroke="currentColor" stroke-width="1" />
                <text class="tier-label" x="52" y="48">2  sender + subject</text>
                <rect x="52" y="52" width="58" height="6" rx="1" fill="rgba(255,255,255,0.08)" />
                <text class="tier-sub" x="54" y="57">From · Subject</text>
                <text class="tier-label" x="124" y="48">3  body + OTP</text>
                <rect x="124" y="52" width="86" height="22" rx="2" fill="rgba(255,255,255,0.06)" stroke="rgba(251,191,36,0.28)" />
                <text class="tier-sub" x="128" y="61">body preview</text>
                <circle class="otp-dot" cx="132" cy="68" r="2.1" />
                <circle class="otp-dot" cx="139" cy="68" r="2.1" />
                <circle class="otp-dot" cx="146" cy="68" r="2.1" />
                <text class="tier-sub" x="154" y="70" fill="#fbbf24">OTP</text>
              </svg>
            </div>
          </div>
          {/* 卡3 Sent box：新增。信封航线 + 时间戳账 */}
          <div class="card reveal">
            <span class="num">03</span>
            <h3>Every send, on the record</h3>
            <p>Agents can send mail too — and you get the ledger. The Sent folder shows what went out: when, from whom, to whom, the subject, and whether it landed (with the failure reason when it didn't). 30 days of history. Message bodies are never stored.</p>
            <div class="card-viz" aria-hidden="true">
              <svg class="viz-sent" viewBox="0 0 220 88" role="img">
                <path class="flight" d="M18 58 C 48 18, 92 8, 132 22" />
                <g class="env-fly">
                  <rect x="126" y="10" width="22" height="15" rx="2" fill="#14161f" stroke="#fbbf24" stroke-width="1.3" />
                  <path d="M127.5 12.2 137 19.2 146.5 12.2" fill="none" stroke="#fbbf24" stroke-width="1.2" />
                </g>
                <line class="ledger-line" x1="10" y1="70" x2="210" y2="70" />
                <text class="ledger" x="12" y="82">14 Aug 14:02  fox → owl  subject</text>
                <text class="ledger ok" x="176" y="82">queued</text>
              </svg>
            </div>
          </div>
          </div></div>
          <div class="why-group"><h3 class="why-heading reveal">For the agent</h3><div class="why-grid">
          {/* 卡4 MCP：文案重写 + 双态小图 */}
          <div class="card reveal">
            <span class="num">04</span>
            <h3>MCP 2026-07-28, local or remote</h3>
            <p>Built on the official SDK v2, current to the dated 2026-07-28 spec. Agents on the same box connect over stdio; cloud agents connect over stateless HTTPS with OAuth. Every authorized client is listed in the dashboard — and revocable.</p>
            <FeatureViz kind="mcp" />
          </div>
          {/* 卡5 Tasks：保留现有正文，只在末尾补批准尾句 */}
          <div class="card reveal">
            <span class="num">05</span>
            <h3>Agent-to-agent tasks</h3>
            {/* #22：邮件工单线程 + 服务端状态戳 + Dashboard 工单视图 + A2A Agent Card */}
            <p>Email-backed task threads with server-stamped states (<code>submitted</code>→<code>working</code>→<code>completed</code>/<code>failed</code>). The receiving agent is woken; the dashboard shows a work-order view. A2A-vocabulary Agent Card at <code>/.well-known/agent-card.json</code> (email transport — not wire-protocol claim). Watch the board, page through history, nudge a stuck task or close one out — you're the dispatcher, not just the observer.</p>
            <FeatureViz kind="tasks" />
          </div>
          <div class="card reveal">
            <span class="num">06</span>
            <h3>Unlimited identities</h3>
            <p>One catch-all mailbox, unlimited <code>anything@yourdomain</code> addresses. No provisioning, no per-inbox cost, no caps.</p>
            <FeatureViz kind="identities" />
          </div>
          <div class="card reveal">
            <span class="num">07</span>
            <h3>Scoped tokens</h3>
            <p>Every identity gets its own <code>oa_…</code> token that can only read and send as that address. Your admin key never touches an agent.</p>
            <FeatureViz kind="tokens" />
          </div>
          <div class="card reveal">
            <span class="num">08</span>
            <h3>wait_for + OTP extraction</h3>
            <p>Long-poll an inbox until the signup mail lands — codes and verification links come out parsed. Built for automated signups.</p>
            <FeatureViz kind="otp" />
          </div>
          </div></div>
          <div class="why-group"><h3 class="why-heading reveal">Your box, your rules</h3><div class="why-grid">
          <div class="card reveal">
            <span class="num">09</span>
            <h3>Safety rails</h3>
            {/* #23：未受信邮件 source 打标 + MCP 围栏；保留原有 rate limit / retention */}
            <p>Per-identity send rate limits (20/hour default) and automatic retention (30 days default). Every message carries <code>source: internal|external</code>; non-internal bodies are fenced at the MCP layer. A leaked token can't become a spam cannon.</p>
            <FeatureViz kind="safety" />
          </div>
          <div class="card reveal">
            <span class="num">10</span>
            <h3>Bring your own relay</h3>
