---
import Legal from '../layouts/Legal.astro';
import EnvelopeOrbit from '../components/EnvelopeOrbit.astro';
import PaperPlane from '../components/PaperPlane.astro';
---

<Legal
  title="Pricing"
  description="openagent.email is free and open source. Hosted Pro Early Bird is available for $30.00/year as a one-time payment."
  wide
>
  <header class="pricing-hero" data-envelope-root>
    <EnvelopeOrbit compact />
    <h1>Pricing</h1>
    <p class="updated">Simple, honest pricing. No per-mailbox caps, ever.</p>
  </header>

  <div class="plans">
    <section class="plan">
      <h2>Self-hosted</h2>
      <p class="price">Free <small>forever</small></p>
      <p class="tagline">Apache-2.0 open source. Runs on your own server.</p>
      <ul>
        <li>Unlimited agent mailboxes on your own domain</li>
        <li>REST API + MCP server (15 tools)</li>
        <li>Dashboard, phone push notifications, agent tasks</li>
        <li>One-command install, ~5 minutes on any VPS</li>
      </ul>
      <p class="cost-note">
        You only pay for your own infrastructure: a VPS (~$4–6/month at any provider) and a
        domain (~$10/year).
      </p>
      <p class="cta"><a class="btn btn-ghost" href="/docs/quickstart/">Get started →</a></p>
    </section>

    <section class="plan">
      <h2>Hosted Pro <span class="badge">Early Bird</span></h2>
      <p class="price">$30.00 <small>/year, one-time</small></p>
      <p class="tagline">
        Same product, we run it for you. No VPS, no setup — your agents get mailboxes on our
        infrastructure.
      </p>
      <ul>
        <li>Unlimited agent mailboxes</li>
        <li>Dashboard, phone push notifications, agent tasks</li>
        <li>Managed updates, backups, and monitoring</li>
        <li>Early birds keep the $30.00/year price when they renew</li>
      </ul>
      <p class="cost-note">
        Early bird — $30.00 for a full year (regular $5.00/month). One-time payment, no
        auto-renewal; early birds keep $30.00/yr on renewal. Secure checkout via Creem — Alipay
        supported.
      </p>
      <div class="cta cta-stack">
        <a class="btn btn-gold" href="https://hosted.openagent.email/checkout/one-time?product_id=prod_2MmEOwu9ph2BJA9JYpLjaB">Buy Hosted Pro — $30/year →</a>
      </div>
    </section>
  </div>

  <h2>Notes</h2>
  <ul>
    <li>Hosted Pro Early Bird is a one-time $30.00 payment for one year, with no auto-renewal.</li>
    <li>
      Questions? Email <a href="mailto:support@openagent.email">support@openagent.email</a>.
    </li>
  </ul>
  <PaperPlane lottie />
</Legal>

<style>
  .plans {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  .pricing-hero { position: relative; padding-bottom: .5rem; }
  @media (min-width: 44rem) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plan {
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.75rem;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
  }
  .plan h2 {
    margin-top: 0;
    min-height: 2.1rem;
  }
  .plan .badge {
    font-size: 0.7rem;
    vertical-align: middle;
    border: 1px solid var(--gold);
    color: var(--gold);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    margin-left: 0.3rem;
    white-space: nowrap;
  }
  .plan .price {
    font-size: 2rem;
    font-weight: 700;
    margin: 0.2rem 0 0.4rem;
    color: var(--ink);
  }
  .plan .price small {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink-faint);
  }
  .plan .tagline {
    margin: 0 0 0.8rem;
    min-height: 3.4rem;
  }
  .plan .cost-note {
    font-size: 0.9rem;
  }
  .plan .cta {
    margin: auto 0 0;
    min-height: 5.8rem;
    display: flex;
    align-items: flex-end;
  }
  .plan .cta-stack {
    display: grid;
    align-content: end;
    gap: 0.65rem;
  }
  .plan .cta .btn {
    width: 100%;
    justify-content: center;
    box-sizing: border-box;
  }
  @media (max-width: 43.99rem) { .plan .tagline { min-height: 0; } }
</style>
