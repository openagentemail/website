---
import Legal from '../layouts/Legal.astro';
---

<Legal
  title="Pricing"
  description="openagent.email is free and open source. Hosted Pro starts at $5/month with a 3-day free trial."
>
  <h1>Pricing</h1>
  <p class="updated">Simple, honest pricing. No per-mailbox caps, ever.</p>

  <div class="plans">
    <section class="plan">
      <h2>Self-hosted</h2>
      <p class="price">Free <small>forever</small></p>
      <p class="tagline">Apache-2.0 open source. Runs on your own server.</p>
      <ul>
        <li>Unlimited agent mailboxes on your own domain</li>
        <li>REST API + MCP server (15 tools)</li>
        <li>Dashboard, phone push notifications, agent tasks</li>
        <li>One-command install, ~5 minutes on any VPS</li>
      </ul>
      <p class="cost-note">
        You only pay for your own infrastructure: a VPS (~$4–6/month at any provider) and a
        domain (~$10/year).
      </p>
      <p class="cta"><a href="/docs/quickstart/">Get started →</a></p>
    </section>

    <section class="plan">
      <h2>Hosted Pro <span class="badge">Available now</span></h2>
      <p class="price">$5 <small>/month</small></p>
      <p class="tagline">
        Same product, we run it for you. No VPS, no setup — your agents get mailboxes on our
        infrastructure.
      </p>
      <ul>
        <li>Unlimited agent mailboxes</li>
        <li>Dashboard, phone push notifications, agent tasks</li>
        <li>Managed updates, backups, and monitoring</li>
        <li>3-day free trial on the monthly plan</li>
      </ul>
      <p class="cost-note"><strong>Early-bird annual plan:</strong> $30/year — <strong>half price</strong> versus monthly, <strong>locked in for life</strong>. No free trial.</p>
      <p class="cta">
        <a href="https://hosted.openagent.email/checkout">Start your 3-day trial — $5/month →</a>
      </p>
      <p class="cta"><a href="https://hosted.openagent.email/checkout?plan=yearly">Lock in early-bird — $30/year →</a></p>
    </section>
  </div>

  <h2>Notes</h2>
  <ul>
    <li>Prices are in USD.</li>
    <li>The $5 monthly plan includes a 3-day free trial. The $30 annual early-bird plan skips the trial but is half the price of paying monthly — and that rate is locked in for as long as you stay subscribed.</li>
    <li>
      Questions? Email <a href="mailto:support@openagent.email">support@openagent.email</a>.
    </li>
  </ul>
</Legal>

<style>
  .plans {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  @media (min-width: 44rem) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plan {
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.75rem;
    padding: 1.25rem 1.4rem;
  }
  .plan h2 {
    margin-top: 0;
  }
  .plan .badge {
    font-size: 0.7rem;
    vertical-align: middle;
    border: 1px solid var(--gold);
    color: var(--gold);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    margin-left: 0.3rem;
    white-space: nowrap;
  }
  .plan .price {
    font-size: 2rem;
    font-weight: 700;
    margin: 0.2rem 0 0.4rem;
    color: var(--ink);
  }
  .plan .price small {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--ink-faint);
  }
  .plan .tagline {
    margin: 0 0 0.8rem;
  }
  .plan .cost-note {
    font-size: 0.9rem;
  }
  .plan .cta a {
    font-weight: 600;
  }
</style>
