---
import Legal from '../layouts/Legal.astro';
import EnvelopeOrbit from '../components/EnvelopeOrbit.astro';
import PaperPlane from '../components/PaperPlane.astro';
import { agentmailLastChecked, agentmailSources } from '../data/agentmailSources.js';
import { mailslurpLastChecked, mailslurpSources } from '../data/mailslurpSources.js';
import { jsonLd } from '../data/jsonld.js';

const pageTitle = 'openagent.email vs AgentMail vs MailSlurp — Agent Email Comparison';
const pageDescription =
  'openagent.email is Apache-2.0 self-hosted agent email; AgentMail is SaaS with enterprise AWS Outposts BYOC; MailSlurp is hosted email and SMS testing.';

const faq = [
  {
    q: 'What is the core difference?',
    a: 'openagent.email is Apache-2.0 software you run on any VPS or cloud. AgentMail is a managed agent-email product: SaaS by default, with enterprise AWS Outposts BYOC. MailSlurp is a hosted platform for testing application email and SMS.',
  },
  {
    q: 'Is openagent.email free and open source?',
    a: 'Yes. It is Apache-2.0 software with no per-inbox fee. You pay for your own server and domain; a small VPS of about $5/month plus a domain covers the infrastructure.',
  },
  {
    q: 'Does AgentMail have BYOC?',
    a: 'Yes. AgentMail\'s enterprise Outposts BYOC option runs send, receive, storage, and search in your AWS account. AgentMail Cloud still operates the dashboard, authentication, billing, upgrades, and product control plane.',
  },
  {
    q: 'When is MailSlurp the better fit?',
    a: 'When you primarily need to test application email and SMS flows without operating mail infrastructure. MailSlurp is SaaS only and offers SMS testing, which openagent.email does not.',
  },
  {
    q: 'Can an agent connect by MCP or API?',
    a: 'Yes. openagent.email includes a REST API and an MCP server. AgentMail has an official MCP and plugin ecosystem. MailSlurp offers an official hosted MCP, REST, language SDKs, and a dashboard.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Legal title={pageTitle} documentTitle={pageTitle} description={pageDescription} wide>
  <script slot="head" type="application/ld+json" set:html={jsonLd(faqJsonLd)} />
  <div class="compare-shell">
  <header class="compare-hero" data-envelope-root>
    <EnvelopeOrbit compact />
    <h1>openagent.email vs AgentMail vs MailSlurp</h1>
    <p class="lede">This page compares three ways to give agents email: openagent.email is Apache-2.0 software you run yourself; AgentMail is a managed agent-email product with enterprise AWS Outposts BYOC; MailSlurp is a hosted platform for testing email and SMS.</p>
    <p class="hero-docs">
      <a href="/docs/quickstart/">Deploy / get started</a>
      <a href="/docs/guides/connect-your-agent/">Connect an agent</a>
    </p>
  </header>
  <section class="picks" aria-labelledby="picks-heading">
    <h2 id="picks-heading">Who should pick which?</h2>
    <p class="picks-note">Fit notes from the facts on this page, not universal recommendations.</p>
    <div class="pick-grid">
      <article class="pick-card">
        <h3>openagent.email</h3>
        <p>A fit when you want open-source control, your own domain and infrastructure, and persistent agent mailboxes.</p>
      </article>
      <article class="pick-card">
        <h3>AgentMail</h3>
        <p>A fit when you prefer managed agent email. Enterprise AWS Outposts BYOC is the existing option when mail content must stay in your AWS account; the vendor still runs the product control plane.</p>
      </article>
      <article class="pick-card">
        <h3>MailSlurp</h3>
        <p>A fit when you primarily test application email and SMS flows and do not want to operate mail infrastructure.</p>
      </article>
    </div>
  </section>
  <div class="table-wrap"><table class="compare"><thead><tr><th></th><th>openagent.email</th><th>AgentMail</th><th>MailSlurp</th></tr></thead><tbody>
    <tr><td>Open source</td><td>Apache-2.0</td><td>Closed source</td><td>Closed source</td></tr><tr><td>Deployment</td><td>Any VPS or cloud</td><td>SaaS or AWS Outposts BYOC</td><td>SaaS only</td></tr><tr><td>Price</td><td>Free software + your server; no per-inbox fee</td><td>Developer/Startup: PAYG +$2 per inbox, domain, or 1k sends; annual plans save 20%</td><td>Capped plans + metered overages</td></tr><tr><td>Unlimited inboxes</td><td>Yes, on your domain</td><td>Paid-tier limits</td><td>Paid-tier limits</td></tr><tr><td>MCP-native</td><td>Yes</td><td>Official MCP and plugin ecosystem</td><td>Official hosted MCP</td></tr><tr><td>Plugins/ecosystem</td><td>Universal MCP: connect directly from Claude, ChatGPT, Grok, or Cursor; official connection guide</td><td>Official OpenClaw plugin + Grok Bot Cursor plugin + official Codex plugin</td><td>Official MCP setup guides for Claude Code, Cursor, Codex, and Gemini CLI</td></tr><tr><td>OTP/link extraction</td><td>Built in</td><td>Not independently verified</td><td>Testing workflows</td></tr><tr><td>Mail data residency</td><td>Your box</td><td>SaaS: theirs; Outposts: your AWS</td><td>Their infrastructure</td></tr><tr><td>Vendor control plane</td><td>None</td><td>Yes, including Outposts</td><td>Yes</td></tr><tr><td>You run a server</td><td>Yes</td><td>No, unless enterprise BYOC</td><td>No</td></tr>
  </tbody></table></div>
  <p class="last-checked">Last checked: AgentMail {agentmailLastChecked} · MailSlurp {mailslurpLastChecked}. <span data-vendor="agentmail">AgentMail sources: {agentmailSources.map((source, index) => <Fragment><a href={source.href} rel="noopener noreferrer">{source.label}</a>{index < agentmailSources.length - 1 ? ', ' : ''}</Fragment>)}.</span> <span data-vendor="mailslurp">MailSlurp sources: {mailslurpSources.map((source, index) => <Fragment><a href={source.href} rel="noopener noreferrer">{source.label}</a>{index < mailslurpSources.length - 1 ? ', ' : ''}</Fragment>)}.</span></p>
  {/* 8-19 脚注：只复述官方 incident 页，不写超出该页的结论 */}
  <p class="note compare-footnote">AgentMail's 19 August 2026 incident page states that outbound sending was disrupted for about eight hours after AWS paused sending on shared email infrastructure. That is AgentMail's own account; no further claim is made here.</p>

  <div class="dims">
    <article class="dim-card">
      <h2>Open source</h2>
      <p>Source availability determines whether you can audit, fork, and keep running the system. openagent.email is Apache-2.0 software with standard SMTP/IMAP underneath. AgentMail and MailSlurp are closed-source hosted products. The trade-off is simple: a managed vendor removes operations; open source leaves the operating choice with you.</p>
    </article>

    <article class="dim-card">
      <h2>Deployment</h2>
      <p>openagent.email runs on any VPS or cloud you choose. AgentMail is hosted SaaS by default, with an enterprise Outposts BYOC option that runs send, receive, storage, and search in your AWS account (AWS today; more clouds planned). MailSlurp is SaaS only. If you never want to operate a server, hosted is the fastest path; self-hosting trades that convenience for portability.</p>
    </article>

    <article class="dim-card">
      <h2>Price</h2>
      <p>openagent.email is free software: a small VPS of about $5/month and a domain cover the infrastructure, with no per-inbox fee. AgentMail's Developer and Startup plans add PAYG at $2 per inbox, domain, or 1k sends, and annual plans save 20%; Outposts is enterprise-tier. MailSlurp meters inboxes and volume. Hosted pricing buys operational convenience, while a fixed server bill is usually easier to predict for many persistent identities.</p>
    </article>

    <article class="dim-card">
      <h2>Unlimited inboxes</h2>
      <p>One openagent.email domain can hold unlimited persistent <code>anything@yourdomain</code> identities without provisioning or per-inbox cost. AgentMail's capacity depends on its paid tier, and so does MailSlurp's. Persistent production mailboxes for agents and inboxes used to test an application are useful for different jobs.</p>
    </article>

    <article class="dim-card">
      <h2>MCP-native access</h2>
      <p>openagent.email includes a REST API, MCP server, and a human dashboard. AgentMail has an official MCP and plugin ecosystem. The deployment and control-plane distinction is that openagent.email is Apache-2.0 software you self-host on any VPS or cloud, with no vendor control plane and unlimited identities on your own domains. MailSlurp offers an official hosted MCP, REST, language SDKs, and a dashboard. The practical difference is not whether an API exists, but whether your agent's primary workflow is mailbox work or testing an application you are building.</p>
    </article>

    <article class="dim-card">
      <h2>OTP and verification links</h2>
      <p>openagent.email automatically extracts OTP codes and verification links while keeping raw text and HTML available. The earlier AgentMail comparison did not independently verify an equivalent extraction feature, so it makes no claim here. MailSlurp is specifically geared to exercising an app's email and SMS flows, and it offers SMS testing, which openagent.email does not.</p>
    </article>

    <article class="dim-card">
      <h2>Mail data residency</h2>
      <p>Your openagent.email mail and tokens stay on your machine. AgentMail Outposts is a real option when email content must stay in AWS, but AgentMail Cloud still operates its dashboard, authentication, billing, upgrades, and product control plane. MailSlurp stores mail in its hosted infrastructure. Residency is a meaningful distinction, but it is not identical to owning the whole stack.</p>
    </article>

    <article class="dim-card">
      <h2>Vendor control plane</h2>
      <p>openagent.email has no vendor control plane: you run the dashboard, auth, upgrades, and mail system. Managed products own those operational pieces, including uptime and deliverability. That is valuable when you want a vendor accountable for operations; it is also the dependency you avoid when you self-host.</p>
    </article>

    <article class="dim-card">
      <h2>You run a server</h2>
      <p>Self-hosting means you own DNS, the machine, and its reputation. In return, you get an auditable stack and can use Amazon SES or another SMTP relay with one environment variable if your VPS provider blocks port 25. AgentMail is the better fit when that is not work you want; MailSlurp is the better fit for CI/QA and zero-infrastructure test inboxes.</p>
    </article>
  </div>

  <div class="dims detail">
    <h2 id="agentmail">AgentMail: deployment and control, in detail</h2>
    <p>AgentMail's enterprise Outposts BYOC option has real AWS data residency. It is not the same as open-source self-hosting, because the AgentMail product control plane remains operated by the vendor. That may be exactly the trade-off an enterprise team wants.</p>
    <p class="note">Fair credit where it is due: Outposts is a real option when email content must stay in AWS. If you want zero servers, AgentMail's managed path is the fastest one.</p>

    <h2 id="mailslurp">Agent workflows beyond the mailbox</h2>
    <p>openagent.email includes a REST API, MCP server, and a human dashboard. AgentMail offers REST, websockets, webhooks, and SDKs; MailSlurp offers an official hosted MCP, REST, language SDKs, and a dashboard. openagent.email automatically extracts OTP codes and verification links while keeping raw text and HTML available. It also has email-backed agent-to-agent task threads with server-stamped states, receiving-agent wake-ups, a dashboard work-order view, an A2A-vocabulary Agent Card, and per-identity ntfy push tiers: interrupt only, sender + subject, or body + OTP, set by an admin. Equivalent task and push features were not verified for the other products, so no claim is made.</p>
  </div>

  <section class="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">FAQ</h2>
    {
      faq.map((item) => (
        <article>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </article>
      ))
    }
  </section>

  <div class="cta-final">
    <PaperPlane lottie />
    <div class="cta-row">
      <a class="btn btn-gold" href="/docs/quickstart/">Deploy / get started →</a>
      <a class="btn btn-ghost" href="/docs/guides/connect-your-agent/">Connect an agent →</a>
      <a class="btn btn-ghost" href="/pricing">See hosted and self-hosted pricing →</a>
    </div>
  </div>
  </div>
</Legal>

<style>
  .compare-shell { width: 100%; max-width: var(--max); margin-inline: auto; }
  .compare-hero {
    position: relative;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
    overflow-x: clip;
  }
  .compare-hero h1 {
    font-size: clamp(1.5rem, 7vw, 2.8rem);
    overflow-wrap: break-word;
    max-width: 100%;
  }
  .compare-hero .lede { max-width: 48rem; margin-bottom: 0; }
  .hero-docs { display: flex; flex-wrap: wrap; gap: 0.85rem 1.4rem; margin: 1.1rem 0 0; font-size: 0.92rem; }
  .picks { margin: 2rem 0 0; }
  .picks > h2 { font-size: 1.18rem; margin: 0 0 0.45rem; }
  .picks-note { margin: 0 0 1rem; font-size: 0.92rem; }
  .pick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .pick-card { min-width: 0; padding: 1.25rem 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-card); }
  .pick-card h3 { font-size: 1rem; margin: 0 0 0.5rem; color: var(--gold); }
  .pick-card p { margin: 0; }
  .table-wrap { width: 100%; overflow-x:auto; margin:2rem 0 3.5rem; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-card); box-shadow: 0 24px 70px rgba(0,0,0,.24); }
  .compare { width:100%; min-width:42rem; border-collapse:collapse; }
  .compare th,.compare td { border-bottom:1px solid var(--line); padding:.82rem 1rem; text-align:left; vertical-align:top; line-height:1.5; }
  .compare tr:last-child td { border-bottom: 0; }
  .compare th,.compare td:first-child { color:var(--ink); font-weight:700; }
  .compare th:nth-child(2),.compare td:nth-child(2) { background: rgba(251,191,36,.055); }
  .compare th:nth-child(2) { color: var(--gold); border-top: 2px solid var(--gold); }
  .last-checked { margin: -2.6rem 0 0.6rem; color: var(--ink-dim); font-family: var(--mono); font-size: 0.78rem; }
  /* 8-19 官方 incident 脚注：跟在 Last checked 后面，不挤进表格 */
  .compare-footnote { margin: 0 0 3.5rem; font-size: 0.9rem; }

  .dims { counter-reset: dim; }
  .dims:not(.detail) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; margin: 0 0 3.5rem; }
  .dim-card { min-width: 0; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-card); }
  .dims > h2,
  .dim-card > h2 {
    counter-increment: dim;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: 1.18rem;
    margin: 0 0 0.6rem;
  }
  .dims > h2::before,
  .dim-card > h2::before {
    content: '0' counter(dim);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--gold);
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-radius: 999px;
    padding: 0.08rem 0.5rem;
    flex-shrink: 0;
    align-self: center;
  }
  .dims > h2 { margin: 2.2rem 0 0.6rem; }
  .dim-card > h2 { margin: 0 0 0.6rem; }
  .dim-card > p { margin: 0; }
  .dims.detail { max-width: 75ch; margin: 0 auto 3.5rem; }
  .dims.detail > h2::before { content: none; }
  .dims.detail > h2 { color: var(--gold); font-size: 1.05rem; }
  .note { color: var(--ink-dim); line-height: 1.7; }

  .faq { max-width: 75ch; margin: 0 auto 3.5rem; }
  .faq > h2 { font-size: 1.18rem; margin: 0 0 1.1rem; }
  .faq article { padding: 1.05rem 0; border-bottom: 1px solid var(--line); }
  .faq article:last-child { border-bottom: 0; padding-bottom: 0; }
  .faq h3 { font-size: 1.02rem; margin: 0 0 0.45rem; }
  .faq p { margin: 0; }

  .cta-final { margin-top: 2.6rem; text-align: center; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .cta-final .lottie-final { margin-bottom: 0.4rem; }
  .cta-row { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; }
  .cta-row .btn-gold { color: #111; }
  .cta-row .btn-ghost { color: var(--ink); }
  .cta-row .btn:hover { text-decoration: none; }

  @media (max-width: 48rem) {
    .compare-hero { padding-bottom: 2rem; }
    .compare-hero :global([data-envelope-orbit]) { display: none; }
    .pick-grid { grid-template-columns: 1fr; }
    .dims:not(.detail) { grid-template-columns: 1fr; }
    .dim-card { padding: 1.25rem; }
  }
</style>
