{
  "name": "openagentemail-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:compare-facts": "node --test tests/compare-facts.test.mjs",
    "test:compare-freshness": "node tests/compare-facts.test.mjs --check-freshness",
    "test:compare-rendered": "node tests/compare-facts.test.mjs --check-rendered",
    "prebuild": "npm run test:compare-freshness",
    "postbuild": "npm run test:compare-rendered"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.7",
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
