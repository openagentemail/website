{
  "name": "openagentemail-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:compare-facts": "node --test tests/compare-facts.test.mjs",
    "test:hosted-checkout": "node --test tests/hosted-checkout.test.mjs",
    "test:mail-security-docs": "node --test tests/mail-security-docs.test.mjs",
    "test:iphone-mail-guide": "node --test tests/iphone-mail-guide.test.mjs",
    "test:compare-freshness": "node tests/compare-facts.test.mjs --check-freshness",
    "test:compare-rendered": "node tests/compare-facts.test.mjs --check-rendered",
    "test:jsonld": "node --test tests/jsonld-escaping.test.mjs",
    "test:jsonld-rendered": "node tests/jsonld-escaping.test.mjs --check-rendered",
    "test:seo-docs": "node --test tests/seo-docs.test.mjs",
    "test:seo-docs-rendered": "node tests/seo-docs.test.mjs --check-rendered",
    "test:llms-txt": "node --test tests/llms-txt.test.mjs",
    "test:llms-txt-rendered": "node tests/llms-txt.test.mjs --check-rendered",
    "test:mcp-tools": "node --test tests/mcp-tools.test.mjs",
    "test:mcp-tools-rendered": "node tests/mcp-tools.test.mjs --check-rendered",
    "test:mcp-tools-upstream": "node tests/mcp-tools.test.mjs --check-upstream",
    "test:webhook-normative": "node tests/webhook-normative.test.mjs",
    "prebuild": "npm run test:compare-freshness && npm run test:hosted-checkout && npm run test:mail-security-docs && npm run test:iphone-mail-guide && npm run test:jsonld && npm run test:seo-docs && npm run test:llms-txt && npm run test:mcp-tools && npm run test:mcp-tools-upstream && npm run test:webhook-normative",
    "postbuild": "npm run test:compare-rendered && npm run test:jsonld-rendered && npm run test:seo-docs-rendered && npm run test:llms-txt-rendered && npm run test:mcp-tools-rendered"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.7",
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
